# Copy to .env.local. Never commit real values.

# Neon Postgres (Vercel Marketplace). Pooled URL for request handlers.
DATABASE_URL=
# Direct (unpooled) URL for migrations and ingest.
DATABASE_URL_UNPOOLED=

# Vercel Blob (detections Parquet, region geometries, large exports).
BLOB_READ_WRITE_TOKEN=

# Server only — FIRMS key for the live layer (Phase 2). Never NEXT_PUBLIC_.
FIRMS_MAP_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data team Fire Calendar API (see docs/adr/0004). Leave empty to use the mock delivery.
FIRE_API_URL=
# Folder of the data team's API project (used by docker-compose.yml)
FIRE_API_DIR=
