{
  "name": "fire-trace",
  "version": "0.1.0",
  "private": true,
  "description": "FIRE TRACE — a sensor-harmonized burning-activity calendar for any area on Earth",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "snapshot": "tsx scripts/export-snapshot.mts",
    "snapshot:geo": ".venv-fire-api/Scripts/python.exe scripts/export_geo.py",
    "contract:validate": "tsx scripts/validate-contract.ts",
    "ingest": "tsx scripts/ingest.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/blob": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "h3-js": "^4.5.0",
    "lucide-react": "latest",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "latest",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^9.0.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.9.1"
}
